# Threadly - Environment Configuration
#
# BEFORE YOU GO LIVE, set these (details further down):
#   NODE_ENV=production, a real SESSION_SECRET (32+ random characters), BASE_URL (your https address),
#   ALLOWED_ORIGIN (your https address) and TRUST_PROXY=1 when the app sits behind nginx or a host's proxy.
# Left on development, the shop accepts requests from any website and logs people out at each restart.
#
# Copy this file to ".env" and fill in your own real values.
# NEVER commit or share your actual .env file - it contains live secrets.
#
# This file ships with NODE_ENV=development so the shop starts on your own computer.
# Set NODE_ENV=production before you go live (see the Server section below).

# Database
# MongoDB connection string. Local example: mongodb://localhost:27017
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
DB_NAME=ecommerce

# Currency code (machine-readable only)
# The shop shows plain numbers and never a currency sign or name. Payment gateways and search engines still need
# a 3-letter ISO 4217 code for the currency your prices are in. Set it once; it is never shown to customers.
# Online payment methods stay switched off until it is set.
CURRENCY_CODE=
# Smallest order total accepted for ANY payment method, a plain number in YOUR currency (default 0 = no minimum;
# a total of 0 is always refused). Set it if tiny orders cost you more to ship than they earn.
# MIN_ORDER_TOTAL=0

# Server
PORT=3000
# Set NODE_ENV=production before you go live (secure cookies, HSTS, strict CORS, and the server refuses to start
# without a real SESSION_SECRET).
# In development a random session secret is used when SESSION_SECRET is not set; logins end when the server restarts.
# In production over plain HTTP also set COOKIE_SECURE=false.
NODE_ENV=development
# The address people use to open your shop, e.g. https://www.example.com (an origin with https://; several origins
# can be separated by commas, e.g. https://example.com,https://www.example.com).
# Needed in production when another site's browser code must call this server, and it is the
# address the cross-site write protection treats as "this site" (together with BASE_URL below).
# Leave it empty when the shop and its pages are served from the same address. In development CORS is open.
ALLOWED_ORIGIN=
# (BASE_URL, further down, is counted as "this site" too. If a reverse proxy changes the Host header, set it to the public address.)
# Number of reverse proxies in front of the app (nginx, a load balancer, a
# hosting platform). Defaults to 0: no proxy is trusted until you set a number.
# Set it to 1 behind a single proxy.
TRUST_PROXY=
# Minutes an unpaid order keeps its stock reserved before it is cancelled
# (minimum 30, default 60). A 10 minute grace period is added on top, so an
# order is not cancelled while its payment window may still be open.
PENDING_ORDER_TTL_MINUTES=60

# Session cookies are Secure (HTTPS only) when NODE_ENV=production. If you run a
# production build over plain HTTP (a test server, an IP address) login would
# silently fail; set COOKIE_SECURE=false for that case only. Leave empty otherwise.
COOKIE_SECURE=
# The page security policy (Content-Security-Policy) is on. Set CSP_DISABLED=true
# only if you must load scripts from a host other than this site, cdn.jsdelivr.net
# and code.jquery.com.
# CSP_DISABLED=false

# Session
# REQUIRED: replace the placeholder below with your own random value (at least
# 32 characters). With NODE_ENV=production the server will not start while this
# is missing, too short, or still the placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Admin Login
# Do NOT put a plain-text password here. Generate the hash with:
#   node scripts/hash-password.js "yourChosenPassword"
# then paste the printed hash below.
ADMIN_USERNAME=admin
# Paste the line printed by hash-password.js exactly, KEEP THE SINGLE QUOTES
# (a hash is full of $ signs, which Docker Compose would otherwise corrupt):
#   ADMIN_PASSWORD_HASH='$2b$12$....'
ADMIN_PASSWORD_HASH=replace-with-output-of-scripts/hash-password.js

# Email (order notifications)
# Any standard SMTP provider works (Gmail App Password, SendGrid, Mailgun, etc.)
# Replace ALL of the values below. While they still look like these examples the
# server treats email as "not configured". Port 465 = SSL/TLS, 587 = STARTTLS.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
# Optional sender shown on emails (default: Threadly <EMAIL_USER>)
# EMAIL_FROM=Threadly <your-email@example.com>
# Force SSL/TLS on or off (default: on for port 465, off otherwise)
# EMAIL_SECURE=true

# SSLCommerz Payment Gateway (Bangladesh)
# Sign up for a store at https://developer.sslcommerz.com to get sandbox
# credentials for free, or your live store credentials for production.
# While these still hold the "your-..." example values, the store treats card
# payment as NOT set up and does not offer it at checkout.
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false
# Public address of your shop, WITHOUT a trailing slash. Used for payment
# redirects AND for canonical links, sitemap.xml and robots.txt. Set it to your
# real domain (for example https://yourshop.com) before going live.
BASE_URL=http://localhost:3000

# Cash on Delivery (optional)
# Set COD_ENABLED=true to offer "Cash on Delivery" at checkout. Off by default.
# A COD order needs a phone number and a delivery address, reserves its stock and
# is placed in PLACED status awaiting staff confirmation.
COD_ENABLED=false
# Optional: the largest order total that may be paid in cash.
COD_MAX_AMOUNT=
# Hours an unconfirmed COD order remains before being automatically cancelled (default: 24).
# COD_CONFIRM_HOURS=24
# Maximum open (non-final) COD orders allowed per customer email/phone (default: 2).
# COD_MAX_OPEN_ORDERS=2
# Maximum quantity per line item allowed on a COD order (default: 3).
# COD_MAX_QUANTITY_PER_LINE=3
# The three settings above fall back to their defaults when a value is out of range (hours: 1 to
# 720, open orders: 1 to 50, quantity: 1 to 99).
# Cash on Delivery orders one address may place per hour (default 5). Stops fake orders from
# holding stock.
# COD_ORDER_RATE_LIMIT_MAX=5

# Manual Payment Gateway (Bank Transfer / Mobile Banking)
# Set MANUAL_PAYMENT_ENABLED=true to offer offline payment instructions at checkout.
MANUAL_PAYMENT_ENABLED=false
# Instructions shown to customer upon placing a manual order (e.g. bank account or mobile banking number).
MANUAL_PAYMENT_INSTRUCTIONS=
# Hours a manual order remains PLACED before being automatically cancelled if unconfirmed (default: 24).
MANUAL_PAYMENT_HOURS=24
# An order whose customer already sent a payment reference is not cancelled at once: it is flagged for you to check and
# kept for this many MORE hours. After that it is cancelled and flagged "Refund due" (so a made-up reference cannot hold stock forever).
MANUAL_PAYMENT_REVIEW_HOURS=72

# SEO (optional)
# Store name used in page titles, Open Graph tags and structured data
# (max 60 characters). Default: Threadly
SITE_NAME=Threadly
# Short description for search results and link previews (max 300 characters).
# Leave empty to use a generic default.
SITE_DESCRIPTION=

# Stripe Payment Gateway (International - optional)
# Optional. Set these to offer an international card option next to SSLCommerz.
# Get keys at https://dashboard.stripe.com/apikeys (use test keys first -
# they start with sk_test_).
STRIPE_SECRET_KEY=
# Card gateways (Stripe, PayPal, Flutterwave, Mollie) charge in CARD_CURRENCY, which is CURRENCY_CODE unless you
# set it here. If the card currency is NOT the currency your prices are in, also set CARD_RATE: how many units of
# the card currency 1 unit of your prices is worth. It is NOT fetched live, and a stale rate over- or undercharges
# every international customer. In production the server refuses to start when the two currencies differ and
# CARD_RATE is missing. Leave both empty when cards are charged in your price currency.
CARD_CURRENCY=
CARD_RATE=
# From https://dashboard.stripe.com/webhooks after adding an endpoint pointing
# to https://yourdomain.com/api/payment/stripe-webhook (or use the Stripe CLI
# for local testing: `stripe listen --forward-to localhost:3000/api/payment/stripe-webhook`)
STRIPE_WEBHOOK_SECRET=

# AI Chatbot (Google Gemini, OpenAI, Anthropic Claude or any OpenAI-compatible service)
# The chat bubble on the shop appears only when the chatbot is switched on AND has a usable key.
# Simplest setup (Google Gemini, free key at https://ai.google.dev/gemini-api/docs): fill in GEMINI_API_KEY and
# CHAT_MODEL (below). The key alone is not enough: without a model name the chatbot stays off.
GEMINI_API_KEY=your-gemini-api-key
# Another provider: set CHAT_PROVIDER to one of  gemini | openai | anthropic | openai-compatible  and fill in the rest.
# OpenAI-compatible covers OpenRouter, Groq, Together, Mistral, DeepSeek, Ollama and LM Studio.
# CHAT_PROVIDER=gemini
# Model name. Required for every provider; there is no built-in default. Check the provider's own
# current model list: model names change often.
# CHAT_MODEL=
# The provider's API key (or use GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY). OPENAI_API_KEY is
# used only for provider openai. openai-compatible uses CHAT_API_KEY alone, and a local server such as
# Ollama or LM Studio needs no key.
# CHAT_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Required for openai-compatible (for example https://openrouter.ai/api/v1 or http://localhost:11434/v1).
# Optional for the others (a gateway or proxy address).
# CHAT_BASE_URL=
# Optional: longest reply in tokens (16 to 8000; Anthropic default 1024, the others choose their own), and creativity (0 to 2).
# CHAT_MAX_TOKENS=
# CHAT_TEMPERATURE=
# Optional: milliseconds one attempt may take (1000 to 120000, default 15000).
# CHAT_TIMEOUT_MS=15000
# Optional: the Anthropic API version header (default 2023-06-01).
# CHAT_ANTHROPIC_VERSION=2023-06-01
# Optional: false switches the chatbot off whatever keys are set.
# CHAT_ENABLED=true
# Optional: model used when the one above keeps failing (comma separated, tried in order, only models YOUR key can use).
# GEMINI_FALLBACK_MODELS is the same setting for Gemini and still works. Empty = no fallback.
# CHAT_FALLBACK_MODELS=
# GEMINI_FALLBACK_MODELS=
# GEMINI_MODEL=
# Optional: retries per model for temporary errors (default 2, max 5), the first wait before a retry in
# milliseconds (default 500, doubled each time, plus a little random jitter), and the longest a customer waits for
# one answer in milliseconds (default 30000). These apply to EVERY provider.
# GEMINI_MAX_RETRIES and the two lines after it are the older names of the same settings and still work.
# CHAT_MAX_RETRIES=2
# CHAT_RETRY_BASE_MS=500
# CHAT_TOTAL_TIMEOUT_MS=30000
# GEMINI_MAX_RETRIES=2
# GEMINI_RETRY_BASE_MS=500
# GEMINI_TOTAL_TIMEOUT_MS=30000
# Optional: most chatbot messages per day for the whole shop, a cost safety net
# (default 2000, 0 = no limit). The count is kept per server process: it resets when the
# server restarts, and with several instances each one has its own count. The server
# warns at start-up if this is 0 while the chatbot is on.
# CHAT_DAILY_LIMIT=2000
# Each visitor address also gets its own daily share of that limit, so one abuser cannot use it
# all up (default 100, 0 = no per-visitor limit). Kept per server process as well.
# CHAT_DAILY_LIMIT_PER_IP=100
# Check your key and model from the command line:  node scripts/chat-check.js "Do you ship to Dhaka?"

# Product pictures (optional)
# Where uploaded product pictures are kept.
#   disk      (default) each picture is a file in UPLOAD_DIR; a product can have up to 6 pictures.
#   database  the picture stays inside the product record (one picture per product). Use this only on hosting
#             without a persistent disk, because files on a temporary disk are lost at every restart.
# UPLOAD_STORAGE=disk
# Folder for the picture files (default: the "uploads" folder of the project). It must be writable and should be
# backed up with the database. With Docker it is a volume (see docker-compose.yml).
# UPLOAD_DIR=uploads

# More international gateways (all optional)
# Each one appears at checkout only when its keys below are filled in. Like
# Stripe, they are charged in CARD_CURRENCY (see above). Use test / sandbox
# keys first.

# PayPal - https://developer.paypal.com/dashboard/applications (create a REST app)
# Use the Sandbox keys while PAYPAL_IS_LIVE=false; switch both to Live keys and
# set PAYPAL_IS_LIVE=true when you go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_IS_LIVE=false
# Optional. The id of a PayPal webhook (events CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED)
# pointing at https://your-domain/api/payment/paypal-webhook. It settles orders whose customer paid
# but never returned to the shop. Without it that URL answers 400.
PAYPAL_WEBHOOK_ID=

# Flutterwave - https://dashboard.flutterwave.com/settings/apis (Test mode keys first)
FLUTTERWAVE_SECRET_KEY=
# Optional but recommended: in Settings, Webhooks, set the URL to
# https://yourdomain.com/api/payment/flutterwave-webhook and put the same
# "Secret hash" here. Without it, orders are still confirmed when the customer
# returns to the shop; the webhook only covers customers who close the page early.
FLUTTERWAVE_WEBHOOK_HASH=

# Mollie - https://my.mollie.com/dashboard/developers/api-keys
# A key starting with test_ is test mode; live_ is real money. The webhook
# (https://yourdomain.com/api/payment/mollie-webhook) is set automatically for
# each payment, but only when BASE_URL is a public https address.
MOLLIE_API_KEY=

# Shipping rates (optional, off by default)
# Set SHIPPING_ENABLED=true to add a delivery fee at checkout. 
# The fee is added after any coupon discount, shown in the cart, and included in
# what the payment gateway charges. Restart the app after changing these.
SHIPPING_ENABLED=false
# Fee for every address, a plain number in your shop's own currency (0 = free delivery everywhere except where you set a rate below).
# Set your own amount before you turn SHIPPING_ENABLED on.
SHIPPING_FLAT_RATE=0
# Orders whose goods (after any coupon) come to at least this amount ship free. 0 = never free.
SHIPPING_FREE_OVER=0
# Optional cheaper (or dearer) rate for one city, matched on the delivery city the
# customer types (capitals and extra spaces do not matter). Leave both empty to skip.
SHIPPING_HOME_CITY=
SHIPPING_HOME_RATE=

# Two-factor admin login (optional, off by default)
# Set to true, restart, then each admin turns it on for themselves with the
# "2FA" button in the admin panel. Admins who have not set it up keep logging in
# with just their password. The secrets are encrypted with a key taken from
# TWO_FACTOR_ENCRYPTION_KEY, or from SESSION_SECRET when that is empty. Pick the key once: if you
# change it later, run the reset below and set 2FA up again.
# Lost phone and backup codes? Run:
#   node scripts/reset-2fa.js <username>
ADMIN_2FA_ENABLED=false
# TWO_FACTOR_ENCRYPTION_KEY=

# Marketplace (multi-vendor, optional)
# true = sellers can apply, are approved in the admin panel (Vendors), manage
# their own products and orders in /vendor.html, and are paid a share of each
# sale. false = a normal single-seller store. Restart after changing.
# Off in this file. Set it to true yourself when you are ready to accept sellers.
MULTIVENDOR_ENABLED=false
# Commission (percent of each item's price, 0-90) a new shop starts with. You can
# change it per shop in the admin panel; changes apply to new orders only.
MARKETPLACE_COMMISSION_PERCENT=10
# Two marketplace money rules, both OFF by default (they change how sellers are paid). Read the README section
# "Money rules" before switching either on. They affect NEW orders and cancellations only.
# SELLER_KEEPS_SHIPPED_ON_CANCEL=true: when a whole order is cancelled, a seller who already shipped their part keeps
# their earnings (their goods are not restocked). Only the other sellers' items are cancelled and restocked.
# SELLER_KEEPS_SHIPPED_ON_CANCEL=false
# COUPON_SPLIT_PRO_RATA=true: a coupon is split over the order's items in proportion to their price, and commission and
# earnings are worked out on the price after the coupon, so sellers carry their share of the discount and a coupon
# bigger than the commission is accepted. false (default) = the marketplace pays for coupons and a coupon that would
# make it pay out more than the customer paid is refused.
# COUPON_SPLIT_PRO_RATA=false
# MARKETPLACE_FUNDS_COUPONS=true keeps the original rule (the marketplace pays for coupons) even if COUPON_SPLIT_PRO_RATA is true.
# MARKETPLACE_FUNDS_COUPONS=false

# --- Store contact details (shown in the website footer) --------------------------
# Leave a line empty to hide it. Nothing is shown unless you set it here.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_ADDRESS=

# Optional limits
# Most orders one IP address may place in 15 minutes (default 20). Raise it if
# many of your customers share an address (mobile carriers do this).
# ORDER_RATE_LIMIT_MAX=20
# Most /api and /admin requests one IP address may make per 15 minutes (default 300, allowed 30 to
# 10000). Raise it if many customers share an address; payment gateway callbacks are never limited.
# API_RATE_LIMIT_MAX=300
# Marketplace: days to keep a seller's delivered earnings "pending" before they
# can be paid out (0 to 90, default 7). A seller marks their own part delivered,
# so the hold gives returns, disputes and card chargebacks time to reach you before
# the money has left. 0 = payable as soon as the seller marks the order delivered.
# PAYOUT_HOLD_DAYS=7

# Public demo only. true = deletes, staff, role, password and 2FA changes, vendor edits, vendor payouts and
# refund marks are refused, and no email is sent. Run `npm run demo:reset -- --yes` from cron (for example
# nightly): it removes orders, coupons, reviews, payouts and customer accounts and reseeds the products.
# It refuses to run unless DB_NAME contains "demo".
DEMO_MODE=false
# Demo owner created by `npm run demo:reset`. The password is required and has no default.
# DEMO_ADMIN_USER=demo
# DEMO_ADMIN_PASSWORD=
# Set CONFIRM=yes to run npm run demo:reset without the --yes flag.
# CONFIRM=
# Set to true to let `npm run demo:reset` run on a database whose name does not contain "demo".
# DEMO_ALLOW_ANY_DB=false
# First-run /setup page. 16+ characters. Needed on any server. Only a plain local run (not production,
# BASE_URL is localhost, no proxy) can leave it empty; a token that is set is always checked.
# SETUP_TOKEN=
# Used by `npm run demo:reset` to pass the demo password to create-admin without showing it in the process list. Do not set it yourself.
# CREATE_ADMIN_PASSWORD=
